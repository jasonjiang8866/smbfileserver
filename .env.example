# Local development example only. Use a dedicated read-only SMB account.
SMB_HOST=192.168.1.100
SMB_PORT=445
SMB_USERNAME=your-username
SMB_PASSWORD=your-password
# SMB_DOMAIN=EXAMPLE
HTTP_ADDR=127.0.0.1:3000
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
# Shared by all reads in this gateway process; not per HTTP request.
SMB_MAX_CONCURRENT_READS=8
# Per-file returned contents, in bytes (32 MiB). Oversized files fail explicitly.
SMB_MAX_FILE_BYTES=33554432
# Native net/http streams HTTP/1.1+ GET by default; HTTP/1.0 GET is buffered.
# fiber explicitly buffers single-file responses and lacks disconnect cancellation.
HTTP_SERVER=nethttp
MAX_BATCH_FILES=100
# Sum of decoded contents retained in successful batch results.
MAX_BATCH_BYTES=33554432
